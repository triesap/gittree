FROM rust:1.92-bookworm AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY services ./services
COPY migrations ./migrations
COPY refs/mf2-i18n ./refs/mf2-i18n
RUN cargo build -p gittree-ui --release

FROM debian:bookworm-slim
RUN useradd -m -u 10001 gittree
COPY --from=builder /app/target/release/gittree-ui /usr/local/bin/gittree-ui
USER gittree
ENTRYPOINT ["/usr/local/bin/gittree-ui"]
