FROM rust:1.92-bookworm AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY services ./services
COPY migrations ./migrations
COPY refs/mf2-i18n ./refs/mf2-i18n
COPY refs/ui-primitives ./refs/ui-primitives
RUN cargo build -p gittree-state --release

FROM debian:bookworm-slim
RUN useradd -m -u 10001 gittree
COPY --from=builder /app/target/release/gittree-state /usr/local/bin/gittree-state
USER gittree
ENTRYPOINT ["/usr/local/bin/gittree-state"]
