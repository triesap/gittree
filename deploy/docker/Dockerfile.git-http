FROM rust:1.85-bookworm AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY services ./services
RUN cargo build -p gittree-git-http --release

FROM debian:bookworm-slim
RUN useradd -m -u 10001 gittree
COPY --from=builder /app/target/release/gittree-git-http /usr/local/bin/gittree-git-http
USER gittree
ENTRYPOINT ["/usr/local/bin/gittree-git-http"]
