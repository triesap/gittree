FROM rust:1.92-bookworm AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY services ./services
COPY migrations ./migrations
RUN cargo build -p gittree-relay --release

FROM debian:bookworm-slim
RUN useradd -m -u 10001 gittree
COPY --from=builder /app/target/release/gittree-relay /usr/local/bin/gittree-relay
USER gittree
ENTRYPOINT ["/usr/local/bin/gittree-relay"]
