# Service bind addresses
GITTREE_RELAY_BIND=0.0.0.0:8080
GITTREE_RELAY_URLS=wss://gittr.ee
GITTREE_RELAY_COMPAT_MODE=strict
GITTREE_RELAY_PROBE_ACTIVE=false
GITTREE_RELAY_PROBE_TIMEOUT_SECS=5
GITTREE_RELAY_PROBE_SECRET_KEY=
GITTREE_ADMISSION_BIND=127.0.0.1:8081
GITTREE_STATE_BIND=127.0.0.1:8082
GITTREE_COORDINATOR_BIND=127.0.0.1:8083
GITTREE_SYNC_BIND=127.0.0.1:8084
GITTREE_GIT_HTTP_BIND=127.0.0.1:8085

# Storage
GITTREE_STORAGE_READ_URL=postgres://gittree:gittree@localhost:5432/gittree
GITTREE_STORAGE_WRITE_URL=postgres://gittree:gittree@localhost:5432/gittree
GITTREE_STORAGE_MAX_CONNECTIONS=10
GITTREE_STORAGE_MIN_CONNECTIONS=2
GITTREE_STORAGE_IDLE_TIMEOUT_SECS=
GITTREE_STORAGE_MAX_LIFETIME_SECS=
GITTREE_STORAGE_APP_NAME=gittree

# Git HTTP
GITTREE_GIT_HTTP_UPSTREAM_URL=http://localhost:3000/
GITTREE_GIT_HTTP_TIMEOUT_SECS=10

# Hook runtime
GITTREE_STATE_URL=http://127.0.0.1:8082
GITTREE_SYNC_URL=http://127.0.0.1:8084
GITTREE_HOOK_MODE=pre-receive
GITTREE_HOOK_STDIN_FILE=deploy/fixtures/git-hook-updates.txt
GITTREE_HOOK_REPO_PATH=deploy/fixtures/repos/npub1gjttreegkzys8jlhdnfm3qe39h2gka79cpndd0jsms5fk7tuhcnsdw56jq/repo.git

# Observability
GITTREE_OTLP_ENDPOINT=
GITTREE_LOG_JSON=false
GITTREE_LOG_DIR=logs
GITTREE_LOG_STDOUT=true
GITTREE_METRICS_ENABLED=true

# Forgejo (docker)
FORGEJO__database__DB_TYPE=sqlite3
FORGEJO__database__PATH=/data/gitea/forgejo.db
FORGEJO__log__MODE=console,file
FORGEJO__log__ROOT_PATH=/data/gitea/log
FORGEJO__log__file__FILE_NAME=forgejo.log
FORGEJO__log__LEVEL=Info
FORGEJO__server__ROOT_URL=http://localhost:3000/
FORGEJO__server__DOMAIN=localhost
FORGEJO__server__HTTP_PORT=3000
FORGEJO__server__SSH_DOMAIN=localhost
FORGEJO__server__SSH_PORT=2222

# Forgejo mailer (local dev via Mailpit)
FORGEJO__mailer__ENABLED=true
FORGEJO__mailer__MAILER_TYPE=smtp
FORGEJO__mailer__FROM=forgejo@localhost
FORGEJO__mailer__SMTP_ADDR=mailpit
FORGEJO__mailer__SMTP_PORT=1025
FORGEJO__mailer__USER=
FORGEJO__mailer__PASSWD=
